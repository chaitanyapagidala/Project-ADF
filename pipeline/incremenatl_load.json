{
	"name": "incremenatl_load",
	"properties": {
		"activities": [
			{
				"name": "GM_List_Source_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_Source_CSV",
						"type": "DatasetReference",
						"parameters": {
							"p_Container": {
								"value": "@pipeline().parameters.p_SourceContainer",
								"type": "Expression"
							},
							"p_FolderPath": {
								"value": "@pipeline().parameters.p_SourceFolder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "FL_Filter_CSV_Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GM_List_Source_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_List_Source_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(\n    equals(item().type, 'File'),\n    endsWith(\n        toLower(item().name),\n        pipeline().parameters.p_FileExtension\n    )\n)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_SourceContainer": {
				"type": "string",
				"defaultValue": "landing"
			},
			"p_SourceFolder": {
				"type": "string",
				"defaultValue": "retail/sales"
			},
			"p_TargetContainer": {
				"type": "string",
				"defaultValue": "bronze"
			},
			"p_FileExtension": {
				"type": "string",
				"defaultValue": ".csv"
			}
		},
		"annotations": []
	}
}