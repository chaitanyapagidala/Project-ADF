{
	"name": "Ingest_retail",
	"properties": {
		"activities": [
			{
				"name": "Get_Metadata_Source_File",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "retail_ingest_source",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"size",
						"lastModified"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "File_exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get_Metadata_Target_File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    activity('Get_Metadata_Source_File').output.exists,\n    and(\n        greater(activity('Get_Metadata_Source_File').output.size, 0),\n        not(activity('Get_Metadata_Target_File').output.exists)\n    )\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Set_Skip_Message",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_ProcessMessage",
								"value": "@if(\n    not(activity('Get_Metadata_Source_File').output.exists),\n    'REJECTED - Source file does not exist',\n    if(\n        equals(activity('Get_Metadata_Source_File').output.size, 0),\n        'REJECTED - Source file is empty',\n        if(\n            activity('Get_Metadata_Target_File').output.exists,\n            'SKIPPED - Target file already exists',\n            'SKIPPED - File validation failed'\n        )\n    )\n)"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy_Sales_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "retail_ingest_source",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "retai_target",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			},
			{
				"name": "Get_Metadata_Target_File",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get_Metadata_Source_File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "retail_ingest_source",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"size",
						"lastModified"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"variables": {
			"v_ErrorMessage": {
				"type": "String"
			},
			"v_ProcessMessage": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-03T07:22:33Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}